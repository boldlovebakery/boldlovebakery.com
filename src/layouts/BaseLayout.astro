---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  draft?: boolean;
}

const {
  title = "Bold Love Farm & Bakery",
  description = "Local food grown, baked, and prepared with care in Mount Airy, Maryland.",
  article = false,
  socialImage,
  socialImageAlt,
  draft = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") + "/";
const canonical = new URL(pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Bold Love Blog" href={new URL("/rss.xml", Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    {socialImage && <meta property="og:image" content={new URL(socialImage, Astro.site)} />}
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <!-- Mailchimp's connected-site loader controls the existing signup popup. -->
    <script is:inline id="mcjs">
      !function(c,h,i,m,p){m=c.createElement(h),p=c.getElementsByTagName(h)[0],m.async=1,m.src=i,p.parentNode.insertBefore(m,p)}(document,"script","https://chimpstatic.com/mcjs-connected/js/users/c1e0805d9318df47dc11e74a1/121b62670c533dbcbe2fbe33f.js");
    </script>
  </head>
  <body>
    <slot />
    {import.meta.env.PROD && !draft && (
      <script is:inline id="cloudflare-analytics">
        // Public site tokens from Cloudflare Web Analytics, not API keys.
        // Leave a token empty to disable analytics for that domain.
        const analyticsTokens = {
          "boldlovefarm.com": "8eadbc0fb63d4df58530c7cfda70ca97",
          "boldlovebakery.com": "d0bae0ac1c5d48799cdb3d8ea07accd0",
        };

        // Both domains share this build. Select by the visitor's actual hostname,
        // so local previews and other hosts never send analytics.
        const hostname = window.location.hostname.replace(/^www\./, "");
        const token = Object.hasOwn(analyticsTokens, hostname) ? analyticsTokens[hostname] : "";

        if (token) {
          const beacon = document.createElement("script");
          beacon.type = "module";
          beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
          beacon.dataset.cfBeacon = JSON.stringify({ token });
          document.body.appendChild(beacon);
        }
      </script>
    )}
  </body>
</html>
